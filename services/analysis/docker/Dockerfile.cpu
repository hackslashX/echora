FROM python:3.12.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /service
# ffmpeg follows the pinned Debian base image security repository.
# hadolint ignore=DL3008
RUN apt-get update \
    && apt-get install --no-install-recommends -y ffmpeg libchromaprint-tools \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 1001 echora
COPY services/analysis/pyproject.toml ./
RUN mkdir -p src/echora_analysis \
    && touch src/echora_analysis/__init__.py \
    && python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir . \
    && /opt/venv/bin/python -m nltk.downloader -d /usr/local/share/nltk_data cmudict \
    && rm -rf src
COPY services/analysis/src ./src
COPY services/analysis/vendor ./vendor
COPY services/analysis/alembic.ini ./alembic.ini
COPY services/analysis/alembic ./alembic
ENV PATH="/opt/venv/bin:$PATH" PYTHONPATH="/service/src" NLTK_DATA="/usr/local/share/nltk_data"
RUN mkdir -p /models/huggingface && chown -R echora /models
EXPOSE 8000
CMD ["sh", "-c", "chown -R echora /models && runuser -u echora -- alembic upgrade head && exec runuser -u echora -- uvicorn echora_analysis.main:app --host 0.0.0.0 --port 8000"]
